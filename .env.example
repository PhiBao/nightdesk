# NightDesk — never commit real keys. Copy to .env.local and fill in.
# TypeSafe (server-side only — never expose to the browser).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Binance Web3 API (signed modules: Trading / Transaction / Wallet / DeFi).
# Public RWA reads work without keys. Fill these when enabling live execution.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://web3.binance.com

# Burner BSC wallet (server-side only — NEVER commit, NEVER expose to browser).
# Small funds only. Used solely for capped live fills via POST /api/fill.
PRIVATE_KEY=
# Hard per-fill USD cap for live broadcasts (code default 10, absolute ceiling 100).
MAX_LIVE_USD=10
